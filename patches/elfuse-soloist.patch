+/* Read-only dynamic-tag inspection. This does not apply relocations. Bound
+ * both the file extent and work before scanning untrusted dynamic entries.
+ */
+static bool elf_read_dynamic(int fd, const elf64_phdr_t *ph,
+                              uint64_t file_size, elf_info_t *info)
+{
+    struct dynamic_entry { int64_t tag; uint64_t value; };
+    if (ph->p_filesz < sizeof(struct dynamic_entry) ||
+        ph->p_filesz > 1024 * 1024 ||
+        ph->p_filesz % sizeof(struct dynamic_entry) ||
+        ph->p_offset > file_size ||
+        ph->p_filesz > file_size - ph->p_offset)
+        return false;
+    for (uint64_t offset = 0; offset < ph->p_filesz;
+         offset += sizeof(struct dynamic_entry)) {
+        struct dynamic_entry entry;
+        if (pread(fd, &entry, sizeof(entry),
+                   (off_t) (ph->p_offset + offset)) != sizeof(entry))
+            return false;
+        if (entry.tag == 0) /* DT_NULL */
+            return true;
+        if (entry.tag == 22 || /* DT_TEXTREL */
+            (entry.tag == 30 && (entry.value & 4))) /* DT_FLAGS/DF_TEXTREL */
+            info->has_text_relocations = true;
+    }
+    return false;
+}
