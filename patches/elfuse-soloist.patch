diff --git a/src/core/text-integrity.c b/src/core/text-integrity.c
new file mode 100644
index 0000000..869d26c
--- /dev/null
+++ b/src/core/text-integrity.c
@@ -0,0 +1,103 @@
+/*
+ * Optional main-ELF/interpreter integrity diagnostic. Snapshots come from the
+ * input files, not guest memory. No guest writes or instruction substitution.
+ * This checks two points in time, not transient writes between them; libraries
+ * subsequently loaded through mmap are not covered by this diagnostic.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "core/text-integrity.h"
+
+#define TEXT_SNAPSHOT_LIMIT (256U * 1024U * 1024U)
+
+bool text_integrity_add(text_integrity_t *check,
+                        const elf_info_t *info,
+                        uint64_t base,
+                        const char *path)
+{
+    if (info->has_text_relocations || info->num_segments < 0 ||
+        info->num_segments > ELF_MAX_SEGMENTS || check->total > TEXT_SNAPSHOT_LIMIT)
+        return false;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return false;
+    bool ok = true;
+    for (int i = 0; i < info->num_segments; i++) {
+        const elf_segment_t *seg = &info->segments[i];
+        if (!(seg->flags & PF_X))
+            continue;
+        if ((seg->flags & PF_W) || seg->filesz > seg->memsz ||
+            seg->memsz > TEXT_SNAPSHOT_LIMIT - check->total ||
+            base > UINT64_MAX - seg->gpa ||
+            base + seg->gpa > UINT64_MAX - seg->memsz ||
+            seg->offset > INT64_MAX ||
+            seg->filesz > (uint64_t) INT64_MAX - seg->offset ||
+            check->count >= 2 * ELF_MAX_SEGMENTS) {
+            ok = false;
+            break;
+        }
+        if (!seg->memsz)
+            continue;
+        unsigned char *bytes = calloc(1, (size_t) seg->memsz);
+        if (!bytes) {
+            ok = false;
+            break;
+        }
+        uint64_t done = 0;
+        while (done < seg->filesz) {
+            ssize_t count = pread(fd, bytes + done,
+                                  (size_t) (seg->filesz - done),
+                                  (off_t) (seg->offset + done));
+            if (count < 0 && errno == EINTR)
+                continue;
+            if (count <= 0) {
+                ok = false;
+                break;
+            }
+            done += (uint64_t) count;
+        }
+        if (!ok) {
+            free(bytes);
+            break;
+        }
+        check->segments[check->count++] = (text_snapshot_t) {
+            .address = base + seg->gpa,
+            .size = (size_t) seg->memsz,
+            .bytes = bytes,
+        };
+        check->total += (size_t) seg->memsz;
+    }
+    close(fd);
+    return ok;
+}
+
+bool text_integrity_verify(const text_integrity_t *check, const guest_t *g)
+{
+    unsigned char buffer[4096];
+    if (!check->count)
+        return false;
+    for (size_t i = 0; i < check->count; i++) {
+        const text_snapshot_t *seg = &check->segments[i];
+        for (size_t offset = 0; offset < seg->size;) {
+            size_t count = seg->size - offset;
+            if (count > sizeof(buffer))
+                count = sizeof(buffer);
+            if (guest_read(g, seg->address + offset, buffer, count) < 0 ||
+                memcmp(buffer, seg->bytes + offset, count) != 0)
+                return false;
+            offset += count;
+        }
+    }
+    return true;
+}
+
+void text_integrity_destroy(text_integrity_t *check)
+{
+    for (size_t i = 0; i < check->count; i++)
+        free(check->segments[i].bytes);
+    memset(check, 0, sizeof(*check));
+}
