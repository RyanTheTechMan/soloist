+/* Append a private argument without placing its content in the host argv.
+ * Only an owner-only regular file is accepted; diagnostics never echo data.
+ */
+static char *read_private_argument(const char *path)
+{
+    /* /dev/fd/N may name an inherited, already-unlinked private file.
+     * It is the sole permitted symlink form; fstat still checks its owner,
+     * mode, regular-file type and size below. */
+    bool inherited_fd = strncmp(path, "/dev/fd/", 8) == 0;
+    if (inherited_fd) {
+        const char *digit = path + 8;
+        if (!*digit)
+            return NULL;
+        for (; *digit; digit++)
+            if (*digit < '0' || *digit > '9')
+                return NULL;
+    }
+    int flags = O_RDONLY | O_CLOEXEC | O_NONBLOCK;
+    int fd = open(path, inherited_fd ? flags : flags | O_NOFOLLOW);
+    if (fd < 0)
+        return NULL;
+    struct stat st;
+    if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) ||
+        st.st_uid != getuid() || (st.st_mode & 077) ||
+        st.st_size < 1 || st.st_size > 4096) {
+        close(fd);
+        return NULL;
+    }
+    size_t size = (size_t) st.st_size, done = 0;
+    char *value = calloc(size + 1, 1);
+    if (!value) {
+        close(fd);
+        return NULL;
+    }
+    while (done < size) {
+        ssize_t count = read(fd, value + done, size - done);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            break;
+        done += (size_t) count;
+    }
+    close(fd);
+    if (done != size || memchr(value, 0, size)) {
+        free(value);
+        return NULL;
+    }
+    while (size && (value[size - 1] == '\n' || value[size - 1] == '\r'))
+        value[--size] = 0;
+    if (!size) {
+        free(value);
+        return NULL;
+    }
+    return value;
+}
