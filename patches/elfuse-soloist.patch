+/* Optional host lifecycle bridge. Keep these signals off vCPU threads just
+ * like the watchdog. Queue before guest startup, and stop touching guest state
+ * before teardown. This is ordinary Linux signal delivery, not a guest hook.
+ */
+static bool g_forward_termination;
+static pthread_mutex_t host_signal_lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned pending_host_signals;
+static bool host_signal_ready;
+
+static void host_signal_drain_locked(void)
+{
+    if (!host_signal_ready)
+        return;
+    if (pending_host_signals & 1)
+        signal_queue(LINUX_SIGINT);
+    if (pending_host_signals & 2)
+        signal_queue(LINUX_SIGTERM);
+    pending_host_signals = 0;
+}
+
+static void host_signal_set_ready(bool ready)
+{
+    if (!g_forward_termination)
+        return;
+    pthread_mutex_lock(&host_signal_lock);
+    host_signal_ready = ready;
+    host_signal_drain_locked();
+    pthread_mutex_unlock(&host_signal_lock);
+}
